APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Display version on About pages (set from your Git tag in CI, e.g. 1.2.0)
APP_VERSION=
# Optional short Git commit shown next to version
APP_RELEASE_GIT_SHA=
# Your repo URL — About page links to …/releases
GITHUB_REPO_URL=
# Optional GitHub token (recommended for private repos / higher rate limit)
GITHUB_TOKEN=
# Optional Google reCAPTCHA keys for login forms
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERIFY_SSL=true
# Cache minutes for latest release API response
GITHUB_RELEASE_CACHE_MINUTES=30
# HTTP timeout (seconds) when calling GitHub API
GITHUB_RELEASE_TIMEOUT_SECONDS=5
# Allow tenant "Apply update" to run git/composer/migrate on this device
TENANT_RELEASE_UPDATER_ENABLED=false
TENANT_RELEASE_UPDATER_TIMEOUT_SECONDS=300
# Override command names when needed (example: "composer.bat" on Windows)
TENANT_RELEASE_UPDATER_COMPOSER_COMMAND=composer
TENANT_RELEASE_UPDATER_PHP_COMMAND=php
# Full path on Windows: use forward slashes (backslashes in "..." break dotenv), e.g. C:/Program Files/Git/cmd/git.exe
TENANT_RELEASE_UPDATER_GIT_COMMAND=git
SUPPORT_EMAIL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rentride
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
